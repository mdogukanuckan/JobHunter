# Bu dosyayi ".env" adiyla kopyala ve degerleri doldur. .env git'e GIRMEZ (.gitignore: *.env).
# Anahtar uretmek icin (PowerShell):
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# Sadece harf/rakam kullan (tirnak, ters bolu olmasin).

# n8n'in credential'lari sifreledigi anahtar. Bir kez belirle, bir daha degistirme.
N8N_ENCRYPTION_KEY=

# n8n → backend: backend'deki Automation:ApiKey ile AYNI deger
#   (gormek icin: dotnet user-secrets list --project src/JobHunter.API)
JOBHUNTER_API_KEY=

# backend → n8n: backend'deki Automation:N8nWebhookSecret ile AYNI deger (yeni uret)
JOBHUNTER_WEBHOOK_SECRET=

# n8n → browser-worker (Faz 10): yeni uret. Sadece n8n ile worker arasinda; backend'e yazilmaz.
BROWSER_WORKER_SECRET=

# n8n -> Telegram Bot API (bildirim, Faz 13): bot'u Telegram'da @BotFather ile olustur, token'i al.
# TELEGRAM_CHAT_ID: bota /start yazdiktan sonra https://api.telegram.org/bot<TOKEN>/getUpdates cevabindaki chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n -> SMTP (e-posta bildirimi, Faz 13 - Telegram ile paralel kanal)
# JOBHUNTER_NOTIFY_EMAIL_TO: bildirimi almak isteyen kullanicinin KENDI e-posta adresi.
#   Her kullanici burayi kendi adresiyle doldurur; kod icinde sabit bir adres yoktur.
JOBHUNTER_NOTIFY_EMAIL_TO=
JOBHUNTER_NOTIFY_EMAIL_FROM=
